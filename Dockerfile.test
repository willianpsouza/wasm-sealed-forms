# Coverage gate image: Go + Rust + cargo-llvm-cov, runs both 80% gates.
FROM rust:1-bookworm

ARG GO_VERSION=1.23.4
RUN apt-get update && apt-get install -y --no-install-recommends make curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-$(dpkg --print-architecture).tar.gz" \
    | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"
RUN rustup component add llvm-tools-preview && cargo install cargo-llvm-cov --locked

WORKDIR /app
COPY . .
RUN go run ./cmd/genkeys .
CMD ["make", "cover", "COVER_MIN=80"]
